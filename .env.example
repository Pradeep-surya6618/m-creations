# Path under /public to the brand logo image. Leave unset to use the wordmark fallback.
NEXT_PUBLIC_LOGO_FILE=/Maria-Creations-Logo.jpeg

# Canonical site URL — set to your production domain when deploying
NEXT_PUBLIC_SITE_URL=http://localhost:4000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=maria_creations

# UPI payee for the dynamic QR
NEXT_PUBLIC_UPI_ID=maria@oksbi
NEXT_PUBLIC_UPI_NAME=Maria Creations

# Admin panel (Phase 3)
ADMIN_EMAIL=maria@mariacreations.in
# IMPORTANT: bcrypt hashes contain three `$` characters which Next.js's
# env loader treats as variable references — each `$` must be backslash-
# escaped. The hashAdminPassword.ts script prints the already-escaped
# form ready to paste. Example shape (note the `\$` sequences):
#   ADMIN_PASSWORD_HASH=\$2b\$10\$abcdefghij...
# Generate with:  npx tsx scripts/hashAdminPassword.ts 'YourPassword'
ADMIN_PASSWORD_HASH=\$2b\$10\$REPLACE_ME_WITH_OUTPUT_FROM_hashAdminPassword_script
ADMIN_SESSION_SECRET=replace-me-with-a-32-plus-char-random-string
